<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/simple_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:id="@+id/header_accounts_action"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/account_status_dot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_account_status_dot" />

            <TextView
                android:id="@+id/tv_accounts_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/simple_accounts"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="19sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/account_expand_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_drop_down"
                app:tint="@color/md_theme_onSurfaceVariant" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/button_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/simple_settings"
            android:padding="10dp"
            android:src="@drawable/ic_settings_24dp"
            app:tint="@color/md_theme_onBackground" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/account_drawer_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        app:cardBackgroundColor="@color/simple_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/md_theme_outlineVariant"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="6dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/account_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/account_drawer_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/simple_add_first_account_short"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="14sp"
                android:visibility="gone" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="@color/color_fab_active" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/tv_account_status"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/simple_status"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_account_remaining"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/simple_value_unavailable"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/account_expiry_progress"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:max="100"
        android:progress="0"
        app:indicatorColor="@color/color_fab_inactive"
        app:trackColor="@color/md_theme_primaryContainer"
        app:trackCornerRadius="7dp"
        app:trackThickness="14dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/workspace_card"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="@color/simple_surface"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/md_theme_outlineVariant"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/tv_workspace_name"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/simple_value_unavailable"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="16sp"
            android:textStyle="bold" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_telegram_channel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:contentDescription="@string/simple_open_telegram"
        android:minHeight="40dp"
        android:textAllCaps="false"
        android:textColor="@color/md_theme_primary"
        android:textSize="12sp"
        android:visibility="gone"
        app:icon="@drawable/ic_telegram_24dp"
        app:iconPadding="6dp"
        app:iconTint="@color/md_theme_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="2dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:contentDescription="@string/tasker_start_service"
            android:focusable="true"
            android:src="@drawable/ic_play_24dp"
            app:backgroundTint="@color/color_fab_inactive"
            app:borderWidth="0dp"
            app:elevation="2dp"
            app:fabCustomSize="82dp"
            app:maxImageSize="34dp"
            app:tint="@color/md_theme_onPrimary" />

        <TextView
            android:id="@+id/tv_test_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/simple_tap_to_connect"
            android:textColor="@color/md_theme_onBackground"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_add"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/simple_add"
                android:minHeight="44dp"
                android:text="@string/simple_add"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:backgroundTint="@color/md_theme_primary"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_add_24dp"
                app:iconPadding="4dp"
                app:iconTint="@color/md_theme_onPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_ping"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/simple_ping"
                android:minHeight="44dp"
                android:text="@string/simple_ping"
                android:textAllCaps="false"
                android:textColor="@color/md_theme_onSecondaryContainer"
                android:textSize="13sp"
                app:backgroundTint="@color/md_theme_secondaryContainer"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_speed_24dp"
                app:iconPadding="4dp"
                app:iconTint="@color/md_theme_onSecondaryContainer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_refresh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/simple_refresh"
                android:minHeight="44dp"
                android:text="@string/simple_refresh"
                android:textAllCaps="false"
                android:textColor="@color/md_theme_onSecondaryContainer"
                android:textSize="13sp"
                app:backgroundTint="@color/md_theme_secondaryContainer"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_refresh_24dp"
                app:iconPadding="4dp"
                app:iconTint="@color/md_theme_onSecondaryContainer" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/simple_servers"
            android:textColor="@color/md_theme_onBackground"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_selected_server_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="12sp" />

    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

</LinearLayout>
