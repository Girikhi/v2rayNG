<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/simple_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/simple_background"
            android:elevation="0dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/simple_background" />

        </com.google.android.material.appbar.AppBarLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="invisible"
            app:indicatorColor="@color/md_theme_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="@string/tasker_start_service"
                android:focusable="true"
                android:src="@drawable/ic_play_24dp"
                app:backgroundTint="@color/md_theme_primary"
                app:borderWidth="0dp"
                app:elevation="2dp"
                app:fabCustomSize="104dp"
                app:maxImageSize="42dp"
                app:tint="@color/md_theme_onPrimary" />

            <TextView
                android:id="@+id/tv_test_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/simple_tap_to_connect"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_add"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/simple_add"
                    android:minHeight="48dp"
                    android:text="@string/simple_add"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:backgroundTint="@color/md_theme_primary"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_add_24dp"
                    app:iconPadding="4dp"
                    app:iconTint="@color/md_theme_onPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_ping"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/simple_ping"
                    android:minHeight="48dp"
                    android:text="@string/simple_ping"
                    android:textAllCaps="false"
                    android:textColor="@color/md_theme_onSecondaryContainer"
                    android:textSize="13sp"
                    app:backgroundTint="@color/md_theme_secondaryContainer"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_speed_24dp"
                    app:iconPadding="4dp"
                    app:iconTint="@color/md_theme_onSecondaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_refresh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/simple_refresh"
                    android:minHeight="48dp"
                    android:text="@string/simple_refresh"
                    android:textAllCaps="false"
                    android:textColor="@color/md_theme_onSecondaryContainer"
                    android:textSize="13sp"
                    app:backgroundTint="@color/md_theme_secondaryContainer"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_restore_24dp"
                    app:iconPadding="4dp"
                    app:iconTint="@color/md_theme_onSecondaryContainer" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/subscription_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="4dp"
            android:text="@string/simple_subscription"
            android:textColor="@color/md_theme_onBackground"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/simple_surface"
            app:tabIndicatorColor="@color/md_theme_primary"
            app:tabIndicatorFullWidth="false"
            app:tabMode="scrollable"
            app:tabRippleColor="@color/md_theme_primaryContainer"
            app:tabSelectedTextColor="@color/md_theme_primary"
            app:tabTextColor="@color/md_theme_onSurfaceVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="6dp"
            android:text="@string/simple_servers"
            android:textColor="@color/md_theme_onBackground"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/menu_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
