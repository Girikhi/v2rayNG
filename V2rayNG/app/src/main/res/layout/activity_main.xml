<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/simple_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/simple_background"
        android:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/simple_background"
            app:navigationIcon="@drawable/ic_subscriptions_24dp"
            app:navigationIconTint="@color/md_theme_onBackground"
            app:title="@string/app_name"
            app:titleCentered="true"
            app:titleTextColor="@color/md_theme_onBackground" />

    </com.google.android.material.appbar.AppBarLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="@color/color_fab_active" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:contentDescription="@string/tasker_start_service"
            android:focusable="true"
            android:src="@drawable/ic_play_24dp"
            app:backgroundTint="@color/color_fab_inactive"
            app:borderWidth="0dp"
            app:elevation="2dp"
            app:fabCustomSize="104dp"
            app:maxImageSize="42dp"
            app:tint="@color/md_theme_onPrimary" />

        <TextView
            android:id="@+id/tv_test_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/simple_tap_to_connect"
            android:textColor="@color/md_theme_onBackground"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_add"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/simple_add"
                android:minHeight="48dp"
                android:text="@string/simple_add"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:backgroundTint="@color/md_theme_primary"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_add_24dp"
                app:iconPadding="4dp"
                app:iconTint="@color/md_theme_onPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_ping"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/simple_ping"
                android:minHeight="48dp"
                android:text="@string/simple_ping"
                android:textAllCaps="false"
                android:textColor="@color/md_theme_onSecondaryContainer"
                android:textSize="13sp"
                app:backgroundTint="@color/md_theme_secondaryContainer"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_speed_24dp"
                app:iconPadding="4dp"
                app:iconTint="@color/md_theme_onSecondaryContainer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_refresh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/simple_refresh"
                android:minHeight="48dp"
                android:text="@string/simple_refresh"
                android:textAllCaps="false"
                android:textColor="@color/md_theme_onSecondaryContainer"
                android:textSize="13sp"
                app:backgroundTint="@color/md_theme_secondaryContainer"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_refresh_24dp"
                app:iconPadding="4dp"
                app:iconTint="@color/md_theme_onSecondaryContainer" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/subscription_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"
        android:text="@string/simple_subscription"
        android:textColor="@color/md_theme_onBackground"
        android:textSize="16sp"
        android:textStyle="bold" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/simple_surface"
        app:tabIndicatorColor="@color/md_theme_primary"
        app:tabIndicatorFullWidth="false"
        app:tabMode="scrollable"
        app:tabRippleColor="@color/md_theme_primaryContainer"
        app:tabSelectedTextColor="@color/md_theme_primary"
        app:tabTextColor="@color/md_theme_onSurfaceVariant" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/subscription_metadata_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/simple_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/md_theme_outlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_panel_workspace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/panel_status_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:visibility="gone"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/tv_panel_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/colorWhite"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_panel_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_panel_remaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_panel_dates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/panel_metadata_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_panel_metadata_details"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/button_panel_telegram"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/simple_open_telegram"
                    android:padding="8dp"
                    android:src="@drawable/ic_telegram_24dp"
                    android:visibility="gone"
                    app:tint="@color/md_theme_primary" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp"
        android:text="@string/simple_servers"
        android:textColor="@color/md_theme_onBackground"
        android:textSize="16sp"
        android:textStyle="bold" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

</LinearLayout>
