<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/simple_background"
    android:fitsSystemWindows="true"
    android:layoutDirection="locale">

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:id="@+id/header_accounts_action"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/account_status_dot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_account_status_dot" />

            <TextView
                android:id="@+id/tv_accounts_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/simple_accounts"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="21sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/account_expand_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:padding="8dp"
                android:rotation="-90"
                android:src="@drawable/ic_arrow_drop_down"
                app:tint="@color/md_theme_onSurfaceVariant" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_language"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/simple_switch_to_english"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/simple_language_english_short"
            android:textAllCaps="false"
            android:textColor="@color/md_theme_primary"
            android:textDirection="ltr"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@color/simple_surface"
            app:cornerRadius="18dp"
            app:strokeColor="@color/md_theme_outlineVariant"
            app:strokeWidth="1dp" />

        <ImageButton
            android:id="@+id/button_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/simple_settings"
            android:padding="10dp"
            android:src="@drawable/ic_settings_24dp"
            app:tint="@color/md_theme_onBackground" />

    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="@color/color_fab_active" />

    <LinearLayout
        android:id="@+id/account_status_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_account_status"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:text="@string/simple_status"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textDirection="locale"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_account_remaining"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:text="@string/simple_value_unavailable"
            android:textColor="@color/md_theme_onSurface"
            android:textDirection="locale"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/account_expiry_progress"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone"
        app:indicatorColor="@color/color_fab_inactive"
        app:trackColor="@color/md_theme_primaryContainer"
        app:trackCornerRadius="8dp"
        app:trackThickness="16dp" />

    <TextView
        android:id="@+id/tv_account_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="11dp"
        android:layout_marginEnd="20dp"
        android:gravity="center"
        android:textColor="@color/md_theme_onSurface"
        android:textDirection="locale"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/account_data_progress"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone"
        app:indicatorColor="@color/color_fab_active"
        app:trackColor="@color/md_theme_primaryContainer"
        app:trackCornerRadius="6dp"
        app:trackThickness="12dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/workspace_card"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/simple_surface"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/md_theme_outlineVariant"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/tv_workspace_name"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/simple_value_unavailable"
            android:textColor="@color/md_theme_onSurface"
            android:textDirection="locale"
            android:textSize="18sp"
            android:textStyle="bold" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_telegram_channel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:contentDescription="@string/simple_open_telegram"
        android:minHeight="44dp"
        android:textAllCaps="false"
        android:textColor="@color/md_theme_primary"
        android:textSize="13sp"
        android:visibility="gone"
        app:icon="@drawable/ic_telegram_24dp"
        app:iconPadding="6dp"
        app:iconTint="@color/md_theme_primary" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="@color/simple_surface"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/md_theme_outlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tv_test_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/simple_tap_to_connect"
                android:textColor="@color/md_theme_onBackground"
                android:textDirection="locale"
                android:textSize="17sp"
                android:textStyle="bold" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="@string/tasker_start_service"
                android:focusable="true"
                android:src="@drawable/ic_play_24dp"
                app:backgroundTint="@color/color_fab_inactive"
                app:borderWidth="0dp"
                app:elevation="3dp"
                app:fabCustomSize="112dp"
                app:maxImageSize="46dp"
                app:tint="@color/md_theme_onPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_add"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/simple_add"
                android:minHeight="50dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/simple_add"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:backgroundTint="@color/md_theme_primary"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_add_24dp"
                app:iconPadding="2dp"
                app:iconSize="18dp"
                app:iconTint="@color/md_theme_onPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_ping"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/simple_ping"
                android:minHeight="50dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/simple_ping"
                android:textAllCaps="false"
                android:textColor="@color/md_theme_onSecondaryContainer"
                android:textSize="13sp"
                app:backgroundTint="@color/md_theme_secondaryContainer"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_speed_24dp"
                app:iconPadding="2dp"
                app:iconSize="18dp"
                app:iconTint="@color/md_theme_onSecondaryContainer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_refresh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:contentDescription="@string/simple_refresh"
                android:minHeight="50dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/simple_refresh"
                android:textAllCaps="false"
                android:textColor="@color/md_theme_onSecondaryContainer"
                android:textSize="13sp"
                app:backgroundTint="@color/md_theme_secondaryContainer"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_refresh_24dp"
                app:iconPadding="2dp"
                app:iconSize="18dp"
                app:iconTint="@color/md_theme_onSecondaryContainer" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/simple_servers"
            android:textColor="@color/md_theme_onBackground"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_selected_server_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textDirection="locale"
            android:textSize="12sp" />

    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/account_drawer_card"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_gravity="left|top"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="58dp"
        app:cardBackgroundColor="@color/simple_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/md_theme_outlineVariant"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="6dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/account_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/account_drawer_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/simple_add_first_account_short"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="14sp"
                android:visibility="gone" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
